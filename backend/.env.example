# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: whisper-large-v3 (best quality) or whisper-large-v3-turbo (faster)
GROQ_WHISPER_MODEL=whisper-large-v3

# Set this to your deployed Vercel URL once the frontend is live, e.g.
# FRONTEND_URL=https://your-transcriber.vercel.app
FRONTEND_URL=
